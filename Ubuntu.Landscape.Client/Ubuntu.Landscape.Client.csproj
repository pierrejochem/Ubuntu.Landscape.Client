<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Ubuntu.Landscape.Client</RootNamespace>
    <AssemblyName>Ubuntu.Landscape.Client</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- NuGet package metadata (replaces Package.nuspec; build with `dotnet pack`) -->
  <PropertyGroup>
    <PackageId>Ubuntu.Landscape.Client</PackageId>
    <Version>1.0.0</Version>
    <Title>Ubuntu Landscape Client</Title>
    <Authors>Pierre Jochem</Authors>
    <Description>Ubuntu Landscape API Client</Description>
    <PackageProjectUrl>https://www.nuget.org/packages/Ubuntu.Landscape.Client</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

</Project>
